+    /// Gives back the physical memory behind every committed page while keeping the reservation,
+    /// so later accesses still read zeroes instead of faulting.
+    void DecommitAll() noexcept {
+        if (base_ptr == nullptr) {
+            return;
+        }
+        for (std::size_t word = 0; word < committed_pages.size(); ++word) {
+            u64 bits = committed_pages[word].load(std::memory_order_acquire);
+            while (bits != 0) {
+                const std::size_t page_index = word * 64 + static_cast<std::size_t>(std::countr_zero(bits));
+                bits &= bits - 1;
+                DecommitPage(page_index * HostPageSize / sizeof(T));
+            }
+        }
+    }
+
     constexpr T& GetUnchecked(size_t index) {
         return base_ptr[index];
     }
